# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# PiAPI Configuration (for Flux image generation and Kling video)
PIAPI_KEY=your_piapi_key_here

# Google Cloud / YouTube API Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Creatomate API (for video editing)
CREATOMATE_API_KEY=your_creatomate_api_key_here
CREATOMATE_TEMPLATE_ID=your_template_id_here
